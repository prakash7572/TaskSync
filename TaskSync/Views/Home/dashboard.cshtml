@{
    Layout = "/views/inner_layout.cshtml";
}
<div>
    <main class="main">
        <div class="dashboard">
            <section class="tasks">
                <h2>Work</h2>
                <p>Get started by adding some tasks</p>
                <button class="btn btn-add-task">Add Task</button>
            </section>
            <section class="agenda">
                <h2>Agenda</h2>

                <div class="calendar">
                    <div class="week-header">
                        <button class="btn">Week</button>
                        <button class="btn">Day</button>
                    </div>
                    <div class="days">
                        <span>Sun 22</span>
                        <span>Mon 23</span>
                        <span>Tue 24</span>
                        <span>Wed 25</span>
                        <span class="selected">Thu 26</span>
                        <span>Fri 27</span>
                        <span>Sat 28</span>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".days span").forEach(day => {
            day.addEventListener("click", () => {
                document.querySelectorAll(".days span").forEach(d => d.classList.remove("selected"));
                day.classList.add("selected");
            });
        });
    });
</script>





