<style>
    .input-error {
        border: 1px solid red;
    }
</style>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/task/js/profile.js"></script>
<div id="accept_cookies_banner" class="bg-neutral">
    <p class="center m0 p2 white medium text-s">
        Our website uses cookies. By continuing we assume your permission to deploy cookies.
    </p>
</div>
<div id="hero">
    <div class="section_inner relative">
        <header>
            <h1 id="logo">
                <a href="/home/index" class="logo_link" title="TaskSync - Free Effortless Collaboration for Teams">
                    <img src="~/image/_tasksync.png" style="height:70px" />
                    <span>TaskSync</span>
                </a>
            </h1>
            <ul class="header_nav">
                <li class="login fkit_dropdown dropdown-single" data-dropdown-position-content="center top+20" data-dropdown-position-parent="center bottom" data-dropdown-callback="dropdownToggleCallback">
                    <a href="#" type="button" class="btn btn-hover-neutral fkit_dropdown_activate" data-login>Login</a>
                    <div class="login-container dropdown-list fkit_dropdown_content" data-login-page style="margin-left: -41px;margin-top: 58px;">
                        <div class="close_wrap">
                            <svg class="login_logo">
                                <use width="124" height="32" xlink:href="#logo" />
                            </svg>
                            <div class="fkit_dropdown_close btn btn-default">Close</div>
                        </div>
                        <form id="login_form" onsubmit="return Login()" class="fkit_form" method="post">
                            <fieldset>
                                <div class="group group_block">
                                    <input id="login_username" class="input" type="email" placeholder="Email" name="Email" value="" data-validation="email">
                                </div>
                                <div class="group group_block">
                                    <input id="login_password" type="password" class="input" name="Password" placeholder="Password" data-validation="password" autocomplete="off">
                                </div>
                                <div class="group group_block">
                                    <input type="submit" class="btn btn-positive" value="Login">
                                </div>
                                <div class="group group_block keeplogin">
                                    <label for="remember_me" class="loggedin"><input type="checkbox" class="remember_me_chk" id="remember_me" name="" checked="checked"> Keep me logged in for 1 weeks</label>
                                </div>
                                <div class="group group_block forgot">
                                    <a id="forgot_password" href="forgot_password.html">Forgot Password?</a>
                                </div>
                            </fieldset>
                        </form>
                    </div>
                </li>
                <li class="register">
                    <a href="#" class="btn go_to_signup btn-positive btn-hover-neutral">Get Started for Free</a>
                </li>
            </ul>
        </header>
        <div id="register" class="col-6">
            <div class="animate zoomIn">
                <h2 class="section_title" style="color:#3474e2">
                    <span>The first</span><br />
                    <b>truly intelligent</b><br />
                    <span class="section_title_under">Task Management</span>
                </h2>
            </div>
            <form id="registration_form" method="post" autocomplete="off">
                <fieldset class="initial">
                    <div class="group email_group gap-3">
                        <div class="field email_field">
                            <input class="input email" type="text" data-validation="email" autocomplete="off" name="Email" placeholder="Email Address" value="">
                        </div>
                        <button class="start_registration btn content-center btn-positive btn-l" type="button" data-registration="true">Start Now!</button>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="input" name="Password" id="Password" placeholder="Password">
                    </div>
                    <div id="timer" data-timer></div>
                </fieldset>
            </form>
        </div>
    </div>
    <div class="fader-black"></div>
    <div class="hero-image"></div>
</div>
<div id="companies" class="relative z2">
    <div class="section_inner relative" style="color:#3474e2">
        <h3 class="heading-s normal center"><b>Trusted by millions of users worldwide:</b></h3>
        <div class="flex items-center justify-center">
        </div>
    </div>
</div>
 
